# Copy to `.env` (git-ignored) and fill in from the Supabase dashboard:
# Project Settings → API.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time and are
# therefore public. Only ever put the *anon* key here. The service_role key
# belongs in the Cloudflare Worker's secrets and nowhere else.
#
# Google sign-in needs no key in this file: it goes through Supabase's OAuth
# endpoint, so the Google client id and secret live in the Supabase dashboard
# under Authentication → Sign In / Providers → Google.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
