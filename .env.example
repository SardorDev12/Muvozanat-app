# Copy to `.env` (git-ignored) and fill in. EXPO_PUBLIC_* values are inlined
# into the JS bundle at build time and are therefore public — only ever put
# the Supabase *anon* key here, never the service role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth client IDs, used by expo-auth-session on native. The web client
# id is also what you paste into Supabase Dashboard → Authentication →
# Providers → Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
